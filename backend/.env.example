APP_NAME=云枢智学 API
APP_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yunshu
MYSQL_USER=yunshu
MYSQL_PASSWORD=replace_with_docker_mysql_password
REDIS_URL=redis://127.0.0.1:6379/0
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace_with_docker_minio_password
MINIO_BUCKET=yszx-files
MINIO_SECURE=false

# 本机HTTP开发环境使用false；正式HTTPS部署须设为true。
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174","http://127.0.0.1:8000","http://localhost:8000"]
